{
  "sourceLanguage" : "vi",
  "strings" : {
    "about.author" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tác giả: %@" } } } },
    "about.copyright" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Copyright © %1$@ %2$@" } } } },
    "about.historical_caveat" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kết quả từ 1800 đến 1975 là lịch Việt Nam hiện đại suy rộng, không phải bản phục dựng lịch chính thức của mọi vùng và thời kỳ lịch sử." } } } },
    "about.license" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giấy phép MIT" } } } },
    "about.privacy_summary" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ứng dụng chạy offline, không yêu cầu tài khoản và không gửi dữ liệu cá nhân ra ngoài máy Mac." } } } },
    "about.runtime_summary" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chỉ sử dụng Apple platform frameworks ở runtime." } } } },
    "about.section.privacy" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền riêng tư" } } } },
    "about.section.scope" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phạm vi và quy ước" } } } },
    "about.section.sources" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nguồn đối chiếu" } } } },
    "about.sources_summary" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quy tắc và kết quả được đối chiếu với tài liệu của Hồ Ngọc Đức, Calendrical Calculations (Edward M. Reingold và Nachum Dershowitz), cùng Hermetic Systems. Không nhúng mã nguồn của các tài liệu này." } } } },
    "about.supported_range" : { "extractionState" : "manual", "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hỗ trợ ngày dương từ 01/01/1800 đến 31/12/2199. Lịch âm Việt Nam và Can–Chi dùng quy ước UTC+7." } } } },
